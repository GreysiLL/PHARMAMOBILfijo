CREATE TABLE producto (
 id INTEGER NOT NULL,
 usuario TEXT NOT NULL,
 nombre TEXT NOT NULL,
 precio REAL NOT NULL,
 stock INTEGER NOT NULL,
 pendiente INTEGER NOT NULL DEFAULT 0,
 estado INTEGER NOT NULL DEFAULT 1,
 categoriaId INTEGER,
 intentos INTEGER NOT NULL DEFAULT 0,
 ultimoError TEXT,
 PRIMARY KEY (usuario, id)
);

listarTodos:
SELECT * FROM producto WHERE usuario = ? AND estado = 1 ORDER BY nombre COLLATE NOCASE;
listarPendientes:
SELECT * FROM producto WHERE usuario = ? AND pendiente = 1 ORDER BY id;
obtener:
SELECT * FROM producto WHERE usuario = ? AND id = ?;
insertar:
INSERT OR REPLACE INTO producto(id, usuario, nombre, precio, stock, pendiente, estado, categoriaId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);
borrarSincronizados:
DELETE FROM producto WHERE usuario = ? AND pendiente = 0;
borrar:
DELETE FROM producto WHERE usuario = ? AND id = ?;
siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto WHERE usuario = ?;


contarFallidas:
SELECT COUNT(*) FROM producto WHERE usuario = ? AND pendiente = 1 AND intentos >= 5;
registrarFallo:
UPDATE producto SET intentos = :intentos, ultimoError = :motivo WHERE usuario = :usuario AND id = :id;
